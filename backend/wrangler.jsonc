{
	"name": "spot-seek-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"vars": {
		// Dev/preview deployment URL — anchors Better Auth's baseURL.
		"BETTER_AUTH_URL": "https://spot-seek-api.dry-base-037d.workers.dev",
		// OWNER REVIEW: public origin used for share links, og:url, canonical,
		// sitemap and email CTAs. Switch to https://spotseek.app when the custom
		// domain is live (see HANDOFF.md / report for the exact steps).
		// Optional: "APP_STORE_URL" (leave unset until the listing exists).
		"PUBLIC_BASE_URL": "https://spot-seek-api.dry-base-037d.workers.dev",
		// OWNER REVIEW: Resend quota guard (src/email-guard.ts). Max real emails per
		// UTC day (plan allows 100; 80 leaves headroom for the owner's own use).
		// Mail to .test/.example/.invalid/.localhost and example.com/.org/.net is
		// always suppressed. Optional "EMAIL_ALLOWLIST" (comma-separated addresses
		// or @domain entries; when set ONLY those get real email) is deliberately
		// left unset.
		"EMAIL_DAILY_CAP": "80"
	},
	"durable_objects": {
		"bindings": [
			{ "name": "CHAT_ROOMS", "class_name": "ChatRoom" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }
	],
	"r2_buckets": [
		{
			"binding": "SPOTSEEK_IMAGES",
			"bucket_name": "spotseek-images",
			"preview_bucket_name": "spotseek-images-preview"
		}
	],
	// Rate limiting (Cloudflare Rate Limiting binding). Declared via `unsafe`
	// because the installed wrangler (3.x) predates the top-level `ratelimits`
	// field; when wrangler is upgraded this can move to `ratelimits`.
	// period must be 10 or 60; namespace_id is an account-unique integer. OWNER REVIEW.
	"unsafe": {
		"bindings": [
			{ "name": "AUTH_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
			{ "name": "RSVP_LIMITER", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
			// Guest web RSVPs: 5/min per client IP. OWNER REVIEW (new namespace id).
			{ "name": "GUEST_LIMITER", "type": "ratelimit", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
		]
	},
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
}
