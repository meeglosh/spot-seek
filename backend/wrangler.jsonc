{
	"name": "spot-seek-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"durable_objects": {
		"bindings": [
			{ "name": "CHAT_ROOMS", "class_name": "ChatRoom" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }
	],
	"r2_buckets": [
		{
			"binding": "SPOTSEEK_IMAGES",
			"bucket_name": "spotseek-images",
			"preview_bucket_name": "spotseek-images-preview"
		}
	],
}
