{
	"name": "spot-seek-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"vars": {
		// Dev/preview deployment URL — anchors Better Auth's baseURL.
		"BETTER_AUTH_URL": "https://spot-seek-api.dry-base-037d.workers.dev"
	},
	"durable_objects": {
		"bindings": [
			{ "name": "CHAT_ROOMS", "class_name": "ChatRoom" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }
	],
	"r2_buckets": [
		{
			"binding": "SPOTSEEK_IMAGES",
			"bucket_name": "spotseek-images",
			"preview_bucket_name": "spotseek-images-preview"
		}
	],
	// Rate limiting (Cloudflare Rate Limiting binding). Declared via `unsafe`
	// because the installed wrangler (3.x) predates the top-level `ratelimits`
	// field; when wrangler is upgraded this can move to `ratelimits`.
	// period must be 10 or 60; namespace_id is an account-unique integer. OWNER REVIEW.
	"unsafe": {
		"bindings": [
			{ "name": "AUTH_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
			{ "name": "RSVP_LIMITER", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
		]
	},
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
}
